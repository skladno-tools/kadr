{
  "description": "opacity, rotation, text size, stroke width and speed have limits",
  "deck": {
    "kadr": "0.1",
    "background": {
      "type": "live",
      "preset": "waves",
      "speed": 5
    },
    "slides": [
      {
        "elements": [
          {
            "type": "text",
            "x": 100,
            "y": 100,
            "w": 800,
            "content": "Text",
            "opacity": 1.5
          },
          {
            "type": "text",
            "x": 100,
            "y": 100,
            "w": 800,
            "content": "Text",
            "rotate": 400
          },
          {
            "type": "text",
            "x": 100,
            "y": 100,
            "w": 800,
            "content": "Text",
            "size": 4
          },
          {
            "type": "shape",
            "shape": "rect",
            "x": 0,
            "y": 0,
            "w": 10,
            "h": 10,
            "strokeWidth": 300
          },
          {
            "type": "code",
            "x": 0,
            "y": 0,
            "w": 10,
            "h": 10,
            "code": "x",
            "size": 300
          }
        ]
      }
    ]
  },
  "errors": [
    {
      "at": "/background/speed",
      "kind": "range"
    },
    {
      "at": "/slides/0/elements/0/opacity",
      "kind": "range"
    },
    {
      "at": "/slides/0/elements/1/rotate",
      "kind": "range"
    },
    {
      "at": "/slides/0/elements/2/size",
      "kind": "choice"
    },
    {
      "at": "/slides/0/elements/3/strokeWidth",
      "kind": "range"
    },
    {
      "at": "/slides/0/elements/4/size",
      "kind": "range"
    }
  ],
  "diagnostics": [
    {
      "code": "bad-value",
      "where": "background",
      "path": "/background/speed",
      "message": "\"speed\" must be from 0 to 4, not 5"
    },
    {
      "code": "bad-value",
      "where": "slide 1, element 1",
      "path": "/slides/0/elements/0/opacity",
      "message": "\"opacity\" must be from 0 to 1, not 1.5"
    },
    {
      "code": "bad-value",
      "where": "slide 1, element 2",
      "path": "/slides/0/elements/1/rotate",
      "message": "\"rotate\" must be from -360 to 360, not 400"
    },
    {
      "code": "bad-value",
      "where": "slide 1, element 3",
      "path": "/slides/0/elements/2/size",
      "message": "\"size\" cannot be 4",
      "hint": "Use a number from 8 to 600, or \"display\", \"title\", \"heading\", \"body\" or \"caption\"."
    },
    {
      "code": "bad-value",
      "where": "slide 1, element 4",
      "path": "/slides/0/elements/3/strokeWidth",
      "message": "\"strokeWidth\" must be from 0 to 200, not 300"
    },
    {
      "code": "bad-value",
      "where": "slide 1, element 5",
      "path": "/slides/0/elements/4/size",
      "message": "\"size\" must be from 8 to 200, not 300"
    }
  ]
}
